# --- SDK ---
FROM node:22-bookworm-slim AS sdk
WORKDIR /src/sdk
COPY sdk/package.json sdk/package-lock.json ./
RUN npm ci
COPY sdk/ ./
RUN npm run build

# --- Client ---
FROM node:22-bookworm-slim AS client
WORKDIR /src
COPY --from=sdk /src/sdk ./sdk
COPY client/package.json client/package-lock.json ./client/
WORKDIR /src/client
RUN npm ci
COPY client/ ./
ARG WACALLS_BASE_URL=""
ENV VITE_WACALLS_BASE_URL=$WACALLS_BASE_URL
RUN npm run build

# --- GO ---
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /wacalls ./cmd/server

# --- Runtime ---
FROM alpine:3.22 AS runtime
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 -h /data wacalls
WORKDIR /data
COPY --from=build /wacalls /wacalls
COPY --from=client /src/client/dist /opt/client/dist
USER wacalls
VOLUME ["/data"]
EXPOSE 8080
CMD ["/wacalls", "-static", "/opt/client/dist", "-addr", ":8080", "-db", "/data/wacalls.db"]
