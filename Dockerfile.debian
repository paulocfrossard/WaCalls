FROM debian:stable AS download

WORKDIR /WaCalls

RUN apt update &&\
    apt install -y \
    golang \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

#FILES
COPY . .    

RUN go mod download

RUN cd client && npm audit && npm audit fix && npm install && npm run build 

EXPOSE 8080
CMD ["sh", "-c","go run ./cmd/server -static client/dist -addr :8080"]